# Line for /etc/fstab on the Pi: mount the NAS share that holds the recipes
# web folder. Needs:  sudo apt install cifs-utils
#
# 1. Create the mount point:      sudo mkdir -p /mnt/nas
# 2. Store the NAS login (readable by root only):
#      sudo install -m 600 /dev/null /etc/samba/recipes-nas.cred
#      sudoedit /etc/samba/recipes-nas.cred      # two lines:
#        username=YOUR_NAS_USER
#        password=YOUR_NAS_PASSWORD
# 3. Add the line below (one line), changing:
#      //nas.local/web  → your NAS name and share
#      uid=pi,gid=pi    → the Pi user that runs deploy.sh and the index timer
# 4. sudo systemctl daemon-reload && sudo mount /mnt/nas && ls /mnt/nas
#
# file_mode/dir_mode let nginx (www-data) read everything while only the
# chosen user can write. x-systemd.automount mounts on first access, so a
# slow NAS doesn't hold up boot; nofail lets the Pi boot when the NAS is off.

//nas.local/web  /mnt/nas  cifs  credentials=/etc/samba/recipes-nas.cred,uid=pi,gid=pi,file_mode=0644,dir_mode=0755,vers=3.0,iocharset=utf8,_netdev,nofail,x-systemd.automount,x-systemd.mount-timeout=30  0  0
