{
  "name": "recipes",
  "private": true,
  "description": "Static recipe browser for schema.org Recipe JSON-LD files",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/unit/*.test.mjs",
    "index:samples": "node tools/build-index.mjs samples/recipes --strict --report",
    "e2e": "playwright test",
    "dev": "node tools/dev-server.mjs",
    "screenshots": "node tools/screenshots.mjs",
    "test:deploy": "node --test test/deploy/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
